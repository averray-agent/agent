FROM docker:29.1.3-cli@sha256:4fa0ee1f3a7e4354c4ea34558b6d4ee32859baf4973d4c8ccc8e7fe3dd730c04 AS docker-cli

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

# The runner reaches Docker only through DOCKER_HOST. It receives no Unix
# socket and does not carry dockerd or the Buildx plugin; production image
# builds happen before this no-listener service starts.
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

WORKDIR /app
COPY mcp-server/package*.json ./
RUN npm install --omit=dev

COPY mcp-server/src ./src
COPY witness /witness

ENV NODE_ENV=production
ENV HOME=/tmp
ENV WITNESS_IMAGE_BUILD=disabled

USER 65532:65532
CMD ["node", "src/services/witness-runner-entry.js"]
