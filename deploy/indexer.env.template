# Indexer runtime env template — rendered by `op inject` at deploy time.
#
# See deploy/backend.env.template header for the editing rules. This file
# is rendered using the `prod-vps-indexer` 1Password service-account token,
# which is scoped to the prod-indexer vault ONLY. Any 1Password reference
# here MUST resolve in prod-indexer; references to other vaults will fail
# render.

# ── Secrets (rendered by op inject) ───────────────────────────────────────

# Postgres connection string for the Ponder indexer. Contains DB password
# in the URL. Rotate by changing the Postgres user password (managed
# separately on the VPS) and updating this 1Password item.
DATABASE_URL=op://prod-indexer/database-url/password

# ── Non-secret config (fill in during PR 2.3 from /srv/agent-stack/indexer.env) ─

PONDER_RPC_URL_420420417=https://eth-rpc-testnet.polkadot.io/
DWELLER_RPC_URL=https://services.polkadothub-rpc.com/testnet/
PONDER_TREASURY_POLICY_ADDRESS=0xE0b8170137f03F90d681451a97C68A9EAf85e4A7
PONDER_ESCROW_CORE_ADDRESS=0xfE841c2dc58E4389b1AB59E3e42F9EB12A694Bea
# Set to the retired v1 EscrowCore only for the bounded drain window.
PONDER_LEGACY_ESCROW_CORE_ADDRESS=
PONDER_AGENT_ACCOUNT_ADDRESS=0x510918E24DEbcA163F306923CA234319e72b22d5
PONDER_REPUTATION_SBT_ADDRESS=0x307bAEa6A05b7136fd94252cB9B6331Ab724C63B
PONDER_START_BLOCK_TREASURY=10689000
PONDER_START_BLOCK_ESCROW=10689000
PONDER_START_BLOCK_REPUTATION=10689000

# DATABASE_SCHEMA is intentionally absent. deploy-production.sh injects the
# last-good value from host state after rendering, or mints one on a new host.
# A committed literal cannot know which schema the running Ponder app owns.

# Indexer process config — added to template in PR 2.3 so render matches
# the live /srv/agent-stack/indexer.env (which has both NODE_OPTIONS and
# PORT defined):
NODE_OPTIONS=--max-old-space-size=2048
PORT=42069

# Bearer token for the /graphql route (POST queries and the GET GraphiQL
# playground share one middleware). Caddy proxies the whole Ponder app on
# index.averray.com and again under app.averray.com/index/, so without this
# token /graphql is an unbounded public query surface and the indexer logs a
# "publicly reachable" warning at startup. When set, every request must carry
# `Authorization: Bearer <token>`.
#
# Critical-nonempty: a render that leaves this empty fails the deploy instead
# of silently reopening the route. The backend's /credit receipt-graph reader
# is the only consumer; it sends the same value from
# INDEXER_GRAPHQL_BEARER_TOKEN (backend template, prod-backend vault). The
# two 1Password items MUST hold the same string because the backend and
# indexer service-account tokens read disjoint vaults: rotate both items,
# then deploy once. Generate with `openssl rand -hex 32`. This key is not a
# Ponder/chain input, so changing it recreates the container without
# rotating DATABASE_SCHEMA. Proof, rotation, and rollback:
# docs/GRAPHQL_BEARER_HARDENING_RUNBOOK.md. Verify with:
#   curl -sS -o /dev/null -w "%{http_code}\n" -X POST https://index.averray.com/graphql
#   curl -sS -o /dev/null -w "%{http_code}\n" -X POST \
#     -H "Authorization: Bearer <token>" https://index.averray.com/graphql
# Expect 401 unauthenticated, 200 with bearer.
GRAPHQL_BEARER_TOKEN=op://prod-indexer/graphql-bearer-token/password
