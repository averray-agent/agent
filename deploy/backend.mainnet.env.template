# Escrow auto-ingested job rewards on-chain at ingestion (reuses the idempotent
# ensureJob), so a job is genuinely funded before discovery advertises it
# claimable; unfundable jobs stay discoverable but report fundingState="pending"
# and are never claimable (no claim-time 409 insufficient_liquidity). Requires
# the backend signer to hold deposited reward liquidity (USDC is not
# auto-mintable). TESTNET-ONLY: only enable on testnet deployments.
# Enabled 2026-06-14 on the Polkadot Hub TestNet deployment (chainId 420420417)
# to activate the self-sustaining loop; keep OFF until a mainnet cutover funds the
# signer for mainnet reward liquidity.
INGESTION_PREFUND_ENABLED=false

# Open is safe only because quote attempts persist no draft/job and the finalized
# watcher materializes catalog state after exact escrow funding is observed.
EXTERNAL_POSTING_MODE=open
EXTERNAL_POSTING_ALLOWLIST=0x089a0A57D001bACb8473161e007F0bAbC1768CeE
EXTERNAL_POSTING_MIN_REWARD_USDC=1
EXTERNAL_POSTING_MAX_REWARD_USDC=10000

# x402 poster ramp — let an agent fund a job WITHOUT holding anything on our chain.
# Payment settles on Base, where the agent's money already is; we front the escrow
# here from the pooled account and settle afterwards. Nothing bridges per job.
#
# ARMED SEPARATELY. Everything below lands while the mode is disabled, so a wiring
# mistake is inert; flipping the mode is its own change, per the two-step
# configure-then-arm pattern. See docs/X402_ENABLEMENT_RUNBOOK.md.
X402_POSTING_MODE=enabled
X402_PUBLIC_ORIGIN=https://api.averray.com
# Base only. The config REFUSES eip155:420420419 — Hub-native settlement and
# per-job bridging are not supported, and our USDC precompile has neither
# EIP-3009 nor Permit2 (verified on chain 2026-08-09).
X402_PAYMENT_NETWORK=eip155:8453
# Circle-native USDC on Base. Verified 2026-08-09 to report symbol USDC on
# chainId 8453 by reading the contract, not from memory.
X402_PAYMENT_ASSET_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# The asset's EIP-712 domain, advertised to payers as `extra` so they can sign
# transferWithAuthorization. This is NOT the symbol.
#
# On Base, symbol() is "USDC" but name() is "USD Coin", and the domain is built
# from name(). We shipped a hardcoded "USDC" and the ramp could not accept a
# payment from anyone: the signature recovered to a different address, and the
# facilitator returned payment_verification_failed with no clue why. The
# readiness check had confirmed symbol() and nobody checked the domain.
#
# Required when enabled; there is no default, because the default was the bug.
# check-x402-ramp-readiness.mjs proves this pair reproduces the asset's on-chain
# DOMAIN_SEPARATOR, so a wrong value fails the check instead of the payer.
X402_PAYMENT_ASSET_EIP712_NAME=USD Coin
X402_PAYMENT_ASSET_EIP712_VERSION=2
# Receives every poster payment. Its key is human-only in mainnet-critical and is
# NOT readable by this service: settlement pushes here, and the key is needed only
# for periodic rebalancing.
X402_PAYMENT_PAY_TO=0x1013E3fe3F6dEb4E61DC023Ff69D420DD9Ce8F9f
# The most the pooled account may have IN FLIGHT at once — postings paid for but
# whose Hub escrow has not been created yet. It is one of two ceilings; the other
# is the pooled account's live liquid balance, read from chain on every 402.
#
# The live read is what makes this self-correcting. A completed posting has
# already left the pool, so the balance reflects it and the cap does not hold
# against it. That was a real production defect on 2026-08-10: settled postings
# were counted forever, so the cap only ever rose, and one 1.05 USDC posting
# against a cap of 2 closed the ramp permanently while the 503 told posters to
# retry in fifteen minutes.
#
# A posting costs the reward PLUS the 5% poster-side fee, so a 1 USDC job needs
# 1.05. A cap of 1 therefore refuses EVERY posting — which is exactly what it did
# on the first live attempt: capRaw 1000000 against requestedRaw 1050000. Size
# this against the reserve, never against the reward.
#
# The pool IS the backend signer (gateway.getPooledFundingAccount returns the
# signer's address), and that same balance pays curated job rewards. In-flight is
# a matter of seconds, so this only has to cover simultaneous posters, while the
# live balance stops a run of them draining the pot that pays workers.
#
# Raised 2 -> 5 on 2026-08-10 once the pool held ~19 USDC. At 2, exactly one
# posting could be in flight and a second simultaneous poster got a 503 — an
# honest refusal that clears in seconds, but a needless one. 5 covers four at
# once and still sits well under the pool. Required when enabled; no default.
X402_POSTING_FLOAT_CAP_USDC=5
X402_POSTING_FLOAT_RETRY_AFTER_SECONDS=900
X402_SETTLEMENT_API_KEY_ID=op://mainnet-backend/x402-cdp-facilitator/username
X402_SETTLEMENT_API_KEY_SECRET=op://mainnet-backend/x402-cdp-facilitator/credential

# Our own MCP clients, so the arrival funnel can report what OUTSIDERS did.
# Comma-separated, case-insensitive, exact names; anything starting with
# "averray-" is treated as ours automatically.
#
# Unmarked traffic counts as EXTERNAL on purpose — the failure we must never
# have is overstating outside interest. Add a name here only when it is
# genuinely our tooling; a canary or adversarial probe sitting in the funnel
# unmarked manufactures demand evidence that is not real.
ARRIVAL_SELF_CLIENTS=
# Operator-owned SIWE wallets. HTTP attribution is wallet-canonical; only an
# explicit entry here is self, and every other authenticated wallet is external.
ARRIVAL_SELF_WALLETS=0x9Ab8531FBb0948C542a31298FD61335f30064239
# Client names WE present routinely that a real outsider could present too.
# Comma-separated, case-insensitive, exact names; added to the built-in list,
# which already carries "Anthropic/ClaudeAI".
#
# A declared name identifies the client SOFTWARE, not the operator: our own
# Claude session and a stranger's announce themselves identically, so no rule
# over that name can separate them. Traffic here is reported as its own bucket
# rather than counted as outside interest — and NOT as ours, which would erase
# the real users who reach us through the same client.
#
# Add a name only if we ourselves use it. A shared client name we never present
# is just an outsider, and belongs in the external count.
ARRIVAL_AMBIGUOUS_CLIENTS=
EXTERNAL_POSTING_DRAFT_TTL_HOURS=72
# A submitted external job escalates to a worker-protecting dispute after 7d.
EXTERNAL_POSTING_REVIEW_WINDOW_HOURS=168
EXTERNAL_POSTING_WATCHER_POLL_MS=15000
EXTERNAL_POSTING_WATCHER_BATCH_SIZE=50
EXTERNAL_POSTING_WATCHER_TIMEOUT_MS=5000
EXTERNAL_POSTING_WATCHER_LAG_BUDGET_SECONDS=600
