---
/**
 * The single navigation used by every page.
 *
 * The homepage and the four topic pages previously shipped two different
 * navs — different brand treatment, different button shape, and a different
 * set of destinations — so following a link from the homepage read as landing
 * on an older version of the product. This is now page-level and identical
 * everywhere, which is what makes the crossover seamless; the homepage's
 * sections stay reachable by scrolling its linear narrative.
 */
interface Props {
  /** Marks the current page in the nav for assistive tech and styling. */
  current?: "agents" | "builders" | "trust" | "schemas" | "record" | null;
}

const { current = null } = Astro.props;

const links = [
  { key: "agents", label: "Agents", href: "/agents/" },
  { key: "builders", label: "Builders", href: "/builders/" },
  { key: "trust", label: "Trust", href: "/trust/" },
  { key: "schemas", label: "Schemas", href: "/schemas/" },
  { key: "record", label: "Record", href: "/transparency/" },
  { key: null, label: "Install MCP", href: "/builders/#install" }
];
---

<nav class="nav" aria-label="Primary">
  <a class="nav__brand" href="/">
    <span class="nav__brand-mark" aria-hidden="true">A</span>
    Averray
  </a>
  {/* Hidden until the nav script runs, so a no-JS visit never gets an
      inert button — it keeps the links visible and wrapping instead. */}
  <button
    class="nav__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="nav-links"
    hidden
  >
    <span class="nav__toggle-bars" aria-hidden="true"></span>
    Menu
  </button>
  <div class="nav__links" id="nav-links">
    {links.map((link) => (
      <a href={link.href} aria-current={link.key !== null && current === link.key ? "page" : undefined}>
        {link.label}
      </a>
    ))}
  </div>
  <a class="nav__cta" href="https://app.averray.com">
    Open operator app <span class="arrow" aria-hidden="true">→</span>
  </a>
</nav>

<!-- Mobile nav disclosure. Inline and tiny so it costs no extra request, and
     gated on the elements existing so it can never strand the links. -->
<script is:inline>
  (function () {
    var nav = document.querySelector(".nav");
    var toggle = nav && nav.querySelector(".nav__toggle");
    var links = nav && nav.querySelector("#nav-links");
    if (!nav || !toggle || !links) return;

    // Only now does the collapsed state apply, so a failed script leaves the
    // links on screen rather than hiding them behind a button that does nothing.
    nav.classList.add("nav--collapsible");
    toggle.hidden = false;

    function setOpen(open) {
      nav.dataset.open = open ? "true" : "false";
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
    }
    setOpen(false);

    toggle.addEventListener("click", function () {
      setOpen(nav.dataset.open !== "true");
    });

    // Tapping a destination should dismiss the panel, including same-page
    // anchors where no navigation event follows.
    links.addEventListener("click", function (event) {
      if (event.target.closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && nav.dataset.open === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>
