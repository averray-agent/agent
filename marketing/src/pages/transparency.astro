---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

/**
 * The public record.
 *
 * Every figure on this page is filled in at runtime from GET /transparency.
 * Nothing here ships with a number in it — the static markup carries em
 * dashes, and a reading that cannot be taken stays an em dash rather than
 * becoming a zero. That is the whole point of the page, so it is enforced
 * in the markup rather than left to the script: there is no number in this
 * file to leak into a screenshot.
 *
 * `data-read` is a dot path into the payload. The reader resolves it, fills
 * the value/unit/source/block/age slots, and sets a status class. Adding a
 * figure means adding markup, not touching the script.
 */
const PAGE_DESCRIPTION =
  "What Averray holds and what it has paid out, read from the chain and published as it is read.";
---

<BaseLayout
  title="Averray — The public record"
  description={PAGE_DESCRIPTION}
  canonicalUrl="https://averray.com/transparency/"
>
  <main class="page">
    <SiteNav current="record" />

    <!-- The reading band. Dark, because it is the same instrument as the
         homepage console: machine output, not prose. -->
    <div class="band" id="top">
      <div class="band__top">
        <div>
          <span class="band__label">Chain head</span>
          <p class="band__height" data-read="chain.head"><span data-value>—</span></p>
        </div>
        <div class="band__right">
          <span class="band__live" data-reader-state="connecting">
            <i aria-hidden="true"></i><span data-reader-label>Connecting</span>
          </span>
          <p class="band__since" data-blocks-since hidden></p>
        </div>
      </div>
      <p class="band__law">
        Two things on this page move on their own: <b>the chain head</b> and <b>the seconds since
        each read</b>. Both are clocks. Every balance below steps once,
        when a reading comes back different — nothing is animated between reads, and no value
        is estimated forward.
      </p>
    </div>

    <div class="record-lede">
      <span class="eyebrow">The public record</span>
      <h1 class="record-title">What the platform holds, as it is being read.</h1>
      <p class="record-sub">
        Averray pays software agents in USDC for verifier-checked work. Its own float sits in a
        lending market. Both are read from the chain, and published here as they are read —
        this is the reading, not a summary of it.
      </p>
      <p class="record-sub">
        This is a deliberately small pilot treasury. Every figure is the live ledger, unedited.
      </p>
    </div>

    <!-- ============ DEPOSIT POOLS ============ -->
    <section class="record-section" aria-labelledby="s-pools" data-deposit-pools>
      <div class="record-head">
        <h2 id="s-pools">Deposit pools</h2>
      </div>
      <div class="record-grid record-grid--2">
        <div class="read">
          <span class="read__label" data-read="depositPools.live.label" data-inline><span data-value>—</span></span>
          <p class="read__value read__value--sm" data-read="depositPools.live.totalAssets" data-inline>
            <span data-value>—</span><span class="read__unit" data-unit></span>
          </p>
          <p class="read__src">Total assets</p>
          <div class="panel__inner">
            <div class="cell" data-read="depositPools.live.bufferAssets">
              <span class="read__label">Pool buffer</span>
              <p class="read__value read__value--sm"><span data-value>—</span><span class="read__unit" data-unit></span></p>
              <p class="read__src" data-source></p>
            </div>
            <div class="cell" data-read="depositPools.live.deployedStatus">
              <span class="read__label">Venue deployment</span>
              <p class="read__value read__value--sm"><span data-value>—</span></p>
              <p class="read__src" data-source></p>
            </div>
          </div>
        </div>
        <div class="read">
          <span class="read__label" data-read="depositPools.legacy.label" data-inline><span data-value>—</span></span>
          <p class="read__value read__value--sm" data-read="depositPools.legacy.totalAssets" data-inline>
            <span data-value>—</span><span class="read__unit" data-unit></span>
          </p>
          <p class="read__src">Total assets</p>
          <div class="panel__inner">
            <div class="cell" data-read="depositPools.legacy.bufferAssets">
              <span class="read__label">Pool buffer</span>
              <p class="read__value read__value--sm"><span data-value>—</span><span class="read__unit" data-unit></span></p>
              <p class="read__src" data-source></p>
            </div>
            <div class="cell" data-read="depositPools.legacy.deployedStatus">
              <span class="read__label">Venue deployment</span>
              <p class="read__value read__value--sm"><span data-value>—</span></p>
              <p class="read__src" data-source></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ TREASURY ============ -->
    <section class="record-section" aria-labelledby="s-holds">
      <div class="record-head">
        <h2 id="s-holds">What the treasury holds</h2>
      </div>
      <div class="record-grid record-grid--4">
        <div class="read" data-read="treasury.totalUsdcEquivalent">
          <span class="read__label">Held, total</span>
          <p class="read__value"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src" data-source></p>
          <div class="read__foot"><span data-block></span><span data-age></span></div>
        </div>
        <div class="read" data-read="treasury.lines.hydrationPosition.total">
          <span class="read__label">In the bank, earning</span>
          <p class="read__value"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src" data-source></p>
          <div class="read__foot"><span data-block></span><span data-age></span></div>
        </div>
        <div class="read" data-read="treasury.lines.assetHubMultisig.balance">
          <span class="read__label">Available on Asset Hub</span>
          <p class="read__value"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src" data-source></p>
          <div class="read__foot"><span data-block></span><span data-age></span></div>
        </div>
        <div class="read" data-read="treasury.lines.operatingFloat.balance">
          <span class="read__label">Working float</span>
          <p class="read__value"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src" data-source></p>
          <div class="read__foot"><span data-block></span><span data-age></span></div>
        </div>
      </div>
    </section>

    <!-- ============ POSITION ============ -->
    <section class="record-section" aria-labelledby="s-pos">
      <div class="record-head">
        <h2 id="s-pos">The position</h2>
      </div>
      <div class="panel">
        <p class="panel__prose">
          These readings are one instrument. The interest is not wired to a display of its own —
          if the cost cannot be read, the interest does not show either.
        </p>
        <div class="panel__inner">
          <div class="cell" data-read="treasury.position.growth">
            <span class="read__label">Realized write-off (venue loss)</span>
            <p class="read__value read__value--sm read__neg"><span data-value>—</span></p>
            <p class="read__src" data-source></p>
          </div>
          <div class="cell" data-read="treasury.position.frictionPaid">
            <span class="read__label">Cost to open it</span>
            <p class="read__value read__value--sm read__neg"><span data-value>—</span></p>
            <p class="read__src" data-source></p>
          </div>
          <div class="cell cell--warn" data-read="treasury.position.netVsCommitted">
            <span class="read__label">Net against committed</span>
            <p class="read__value read__value--sm"><span data-value>—</span></p>
            <p class="read__src" data-source></p>
          </div>
        </div>

        <!-- The adapter books genuinely cannot split principal from accrued
             yield before settlement. The payload publishes both as unknown
             and ships the reason as a field; print the reason rather than
             two empty boxes pretending to be a breakdown. -->
        <div class="panel__note" data-read="treasury.lines.hydrationPosition.note">
          <span class="read__label">Why there is no principal / yield split</span>
          <p class="panel__note-text" data-value>—</p>
        </div>

        <div class="panel__inner">
          <div class="cell" data-read="treasury.position.deposited">
            <span class="read__label">Deposited</span>
            <p class="read__value read__value--sm"><span data-value>—</span></p>
            <p class="read__src" data-source></p>
          </div>
          <div class="cell" data-read="treasury.position.positionNow">
            <span class="read__label">Position now</span>
            <p class="read__value read__value--sm"><span data-value>—</span></p>
            <p class="read__src" data-source></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WORK ============ -->
    <section class="record-section" aria-labelledby="s-work">
      <div class="record-head">
        <h2 id="s-work">Work paid for</h2>
      </div>
      <div class="record-grid record-grid--4">
        <div class="read read--flat" data-read="flow.usdcPaid.last24h">
          <span class="read__label">Paid to workers · 24 h</span>
          <p class="read__value read__value--sm"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src"><span data-read="flow.jobsSettled.last24h" data-inline><span data-value>—</span></span> jobs settled</p>
        </div>
        <div class="read read--flat" data-read="flow.usdcPaid.last7d">
          <span class="read__label">Paid to workers · 7 d</span>
          <p class="read__value read__value--sm"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src"><span data-read="flow.jobsSettled.last7d" data-inline><span data-value>—</span></span> jobs settled</p>
        </div>
        <div class="read read--flat" data-read="flow.usdcPaid.allTime">
          <span class="read__label">Paid to workers · all time</span>
          <p class="read__value read__value--sm"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src"><span data-read="flow.jobsSettled.allTime" data-inline><span data-value>—</span></span> jobs settled</p>
        </div>
        <div class="read read--flat" data-read="flow.settledToExternalWallets24h">
          <span class="read__label">Settled to external wallets (24h)</span>
          <p class="read__value read__value--sm"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src" data-source></p>
          <div class="read__foot"><span data-block></span><span data-age></span></div>
        </div>
      </div>
    </section>

    <!-- ============ COMPOSITION — the honest one ============ -->
    <section class="record-section" aria-labelledby="s-comp">
      <div class="record-head">
        <h2 id="s-comp">Where that work came from</h2>
      </div>
      <div class="panel">
        <p class="panel__prose">
          This is the same last-24-hour work split by job origin: platform verification,
          ingested catalogue work, externally posted work, or unclassified. It does not classify
          claimants; the external-wallet settlement counter above does that through the shared
          self-identity registry.
        </p>
        <div class="comp" data-comp hidden>
          <span class="comp__platform" data-comp-bar="platformVerificationRuns"></span>
          <span class="comp__ingested" data-comp-bar="ingested"></span>
          <span class="comp__external" data-comp-bar="external"></span>
          <span class="comp__unclassified" data-comp-bar="unclassified"></span>
        </div>
        <div class="legend">
          <div data-read="flow.composition24h.platformVerificationRuns" data-inline>
            <i class="comp__platform"></i>Platform verification runs <b data-value>—</b>
          </div>
          <div data-read="flow.composition24h.ingested" data-inline>
            <i class="comp__ingested"></i>Ingested work <b data-value>—</b>
          </div>
          <div data-read="flow.composition24h.external" data-inline>
            <i class="comp__external"></i>Externally posted <b data-value>—</b>
          </div>
          <div data-read="flow.composition24h.unclassified" data-inline>
            <i class="comp__unclassified"></i>Unclassified <b data-value>—</b>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ESCROW ============ -->
    <section class="record-section" aria-labelledby="s-escrow">
      <div class="record-head">
        <h2 id="s-escrow">Money owed and money held</h2>
      </div>
      <div class="record-grid record-grid--2">
        <div class="read" data-read="escrow.posterObligationsInFlight">
          <span class="read__label">Owed to posters</span>
          <p class="read__value read__value--sm"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src" data-source></p>
          <div class="read__foot"><span data-block></span><span data-age></span></div>
        </div>
        <div class="read" data-read="escrow.balanceHeldByEscrowContract">
          <span class="read__label">Held in escrow</span>
          <p class="read__value read__value--sm"><span data-value>—</span><span class="read__unit" data-unit></span></p>
          <p class="read__src" data-source></p>
          <div class="read__foot"><span data-block></span><span data-age></span></div>
        </div>
      </div>
      <p class="record-aside">Two readings, side by side. No coverage figure is computed from them.</p>
    </section>

    <!-- ============ PROVENANCE ============ -->
    <section class="record-section" aria-labelledby="s-prov">
      <div class="record-head">
        <h2 id="s-prov">Which contract these readings came from</h2>
      </div>
      <div class="panel">
        <div class="panel__inner">
          <div class="cell" data-read="treasury.generation.wrapperAddress">
            <span class="read__label">Wrapper</span>
            <p class="read__value read__value--addr"><span data-value>—</span></p>
            <p class="read__src" data-source></p>
          </div>
          <div class="cell" data-read="treasury.generation.version">
            <span class="read__label">Generation</span>
            <p class="read__value read__value--sm"><span data-value>—</span></p>
          </div>
          <div class="cell" data-read="treasury.generation.state">
            <span class="read__label">State</span>
            <p class="read__value read__value--sm"><span data-value>—</span></p>
            <p class="read__src" data-read="treasury.generation.reason" data-inline><span data-value></span></p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ READER LOG ============ -->
    <section class="record-section" aria-labelledby="s-log">
      <div class="record-head">
        <h2 id="s-log">The reader, out loud</h2>
      </div>
      <div class="log">
        <span class="log__label">Reader log · newest first</span>
        <div data-log>
          <div class="log__line log__dim">waiting for the first read…</div>
        </div>
      </div>
    </section>

    <div class="laws">
      <p><b>What moves:</b> the chain head, and the “seconds since read” under each value. Both are clocks.</p>
      <p><b>What steps:</b> the balances — once per read, and only when the read comes back different.</p>
      <p><b>What never happens:</b> a number counting up between readings. If it looks smooth, it is time, not money.</p>
      <p><b>What is not here:</b> what Averray earns. Platform revenue is not published on this page.</p>
    </div>

    <SiteFooter />
  </main>

  <script is:inline src="/reader-fetch.js?v=20260823"></script>
  <script is:inline src="/transparency-reader.js?v=20260821"></script>
</BaseLayout>
