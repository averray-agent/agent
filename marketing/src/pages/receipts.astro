---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
---

<BaseLayout
  title="Averray — Work receipt"
  description="A content-addressed record of one work run: intent, execution, verdict, and settlement."
  canonicalUrl="https://averray.com/receipts/"
>
  <main class="page">
    <SiteNav />
    <div class="record-lede">
      <span class="eyebrow">Work receipt</span>
      <h1 class="record-title">One run, from agreement to outcome.</h1>
      <p class="record-sub">This page reads an immutable, signed receipt from the Averray API. It attests only the single run shown here.</p>
    </div>

    <section class="record-section" aria-live="polite">
      <div class="panel" data-receipt-state="loading">
        <p data-receipt-status>
          Loading the receipt… · raw JSON:
          <a data-receipt-raw-url href="https://api.averray.com/receipts/">api.averray.com/receipts/&#123;receiptId&#125;</a>
        </p>
        <noscript>
          <p>Loading the receipt requires JavaScript · raw JSON: <a href="https://api.averray.com/receipts/">api.averray.com/receipts/&#123;receiptId&#125;</a></p>
        </noscript>
        <div data-receipt hidden>
          <p><strong>Receipt</strong> <code data-field="receiptId"></code></p>
          <p><strong>Outcome</strong> <span data-field="verdict.outcome"></span> · <span data-field="verdict.reasonCode"></span></p>
          <p><strong>Provider</strong> <code data-field="execution.provider"></code> (<span data-field="execution.providerClass"></span>)</p>
          <p><strong>Job</strong> <span data-field="jobId"></span></p>
          <p><strong>Specification</strong> <code data-field="intent.specHash"></code> (<span data-field="intent.specSource"></span>)</p>
          <p><strong>Success policy</strong> <span data-field="intent.successPolicy.profile"></span> v<span data-field="intent.successPolicy.version"></span></p>
          <p><strong>Artifact</strong> <code data-field="execution.artifactHash"></code></p>
          <p><strong>Verified</strong> <time data-field="timestamps.verifiedAt"></time></p>
          <div data-settlement hidden>
            <p><strong>Worker reward</strong> <span data-field="settlement.rewardAmount"></span> <span data-field="settlement.assetSymbol"></span>: <span data-field="settlement.workerAmount"></span> paid; <span data-field="settlement.gasRetentionAmount"></span> retained.</p>
            <p><strong>Poster total</strong> <span data-field="settlement.posterTotalAmount"></span> <span data-field="settlement.assetSymbol"></span>, including <span data-field="settlement.protocolFeeAmount"></span> protocol fee.</p>
          </div>
          <details>
            <summary>Canonical JSON</summary>
            <pre data-receipt-json></pre>
          </details>
        </div>
      </div>
    </section>
    <SiteFooter />
  </main>
  <script src="/reader-fetch.js?v=20260821" is:inline></script>
  <script src="/receipt-reader.js?v=20260821" is:inline></script>
</BaseLayout>
