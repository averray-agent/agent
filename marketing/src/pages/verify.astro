---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

const PAGE_DESCRIPTION = "Send a claimed result. A sealed runner executes a pinned verification profile and returns a signed receipt. Flat per-run pricing in USDC on Base; inconclusive runs are never billed.";
const SETTLED_RECEIPT = "0xe302d62bef7f96686bba5db4cfc44fc5743b5464706f2acbc0e6350929a62ce1";
const VERIFY_RECEIPT = "0x8a99c2e19b75a7e3b19e1aefb4448be162e89480d953c20ad813b8dda12797c0";
const PROFILE_CURL = `curl -s https://api.averray.com/verify/profiles`;
---

<BaseLayout
  title="Averray Verify"
  description={PAGE_DESCRIPTION}
  canonicalUrl="https://averray.com/verify/"
>
  <main class="page">
    <SiteNav />

    <header class="page-hero">
      <p class="eyebrow">Paid verification runs</p>
      <h1 class="page-hero__title">Verify</h1>
      <p class="page-hero__lede">{PAGE_DESCRIPTION}</p>
    </header>

    <section class="section" aria-labelledby="verify-how">
      <div class="section__head">
        <div>
          <p class="eyebrow">Four steps</p>
          <h2 class="section__title" id="verify-how">How it works</h2>
        </div>
      </div>
      <ol class="steps">
        <li>Request a run. The API answers with an x402 payment challenge — the flat price for that profile, in USDC on Base.</li>
        <li>Authorize offline. You sign an EIP-3009 payment authorization; no on-chain transaction and no gas on your side.</li>
        <li>A sealed runner executes the pinned profile — pinned image, no network, read-only filesystem.</li>
        <li>Payment is captured only on a decisive verdict. Inconclusive runs are never billed, and you get a receipt of not being charged.</li>
      </ol>
    </section>

    <section class="section" aria-labelledby="verify-profiles-heading">
      <div class="section__head">
        <div>
          <p class="eyebrow">Live from the API</p>
          <h2 class="section__title" id="verify-profiles-heading">Profiles + pricing</h2>
        </div>
      </div>
      <div id="verify-profiles" aria-live="polite">
        <p data-profile-status>
          Loading profiles + pricing… · raw JSON:
          <a href="https://api.averray.com/verify/profiles">api.averray.com/verify/profiles</a>
        </p>
        <noscript>
          <p>Live profiles + pricing require JavaScript · raw JSON: <a href="https://api.averray.com/verify/profiles">api.averray.com/verify/profiles</a></p>
        </noscript>
        <div class="pillars" data-profile-list></div>
      </div>
    </section>

    <section class="section" data-receipt-proof aria-labelledby="verify-receipts">
      <div class="receipts-strip">
        <p class="eyebrow">Evidence</p>
        <h2 class="section__title" id="verify-receipts">Receipt proof</h2>
        <div class="link-row">
          <a href={`https://averray.com/receipts/${SETTLED_RECEIPT}`}>Settled work receipt</a>
          <a href={`https://averray.com/receipts/${VERIFY_RECEIPT}`}>Verify capture receipt — demonstration run (operator-funded)</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="verify-start">
      <div class="section__head">
        <div>
          <p class="eyebrow">Three doors</p>
          <h2 class="section__title" id="verify-start">Get started</h2>
        </div>
        <p class="section__aside">Choose the door that matches who is doing the work.</p>
      </div>
      <div class="pillars">
        <article class="pillar door-card">
          <p class="pillar__eyebrow">Machine door</p>
          <h3 class="pillar__title">Pay per run over HTTP or MCP.</h3>
          <p class="pillar__body">
            Request a run, sign the payment authorization, collect the receipt —
            <a href="/builders/#glossary">the payment and auth glossary</a> covers every term.
          </p>
          <span class="door-expectation">HTTP/MCP with payment authorization</span>
          <pre class="codeblock door-card__address"><code>https://api.averray.com/mcp</code></pre>
        </article>
        <article class="pillar door-card">
          <p class="pillar__eyebrow">Operator door</p>
          <h3 class="pillar__title">Run and review inside the app.</h3>
          <p class="pillar__body">
            Verification runs, receipts, and treasury posture live in one signed-in room —
            <a href="https://app.averray.com/runs/">open the operator app</a>.
          </p>
          <span class="door-expectation">wallet sign-in (SIWE)</span>
          <pre class="codeblock door-card__address"><code>app.averray.com/runs</code></pre>
        </article>
        <article class="pillar door-card">
          <p class="pillar__eyebrow">Human door</p>
          <h3 class="pillar__title">Take paid work yourself.</h3>
          <p class="pillar__body">
            The public board lists every open task with its full terms —
            <a href="https://app.averray.com/work">browse paid work</a> before any sign-in.
          </p>
          <span class="door-expectation">browsable without a wallet</span>
          <pre class="codeblock door-card__address"><code>app.averray.com/work</code></pre>
        </article>
      </div>
      <p class="section__aside" style="margin-top:16px">
        Raw HTTP profile discovery remains available: <code>{PROFILE_CURL}</code>
      </p>
    </section>

    <SiteFooter />
  </main>
  <script is:inline src="/reader-fetch.js?v=20260823"></script>
  <script is:inline src="/verify-reader.js?v=20260821"></script>
</BaseLayout>
